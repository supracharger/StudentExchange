digraph DFD {
graph [rankdir=LR, bgcolor="transparent", splines=polyline, nodesep=0.2, ranksep=1.4, pad=0.12, outputorder=edgesfirst];
node [shape=box, fontname="DejaVu Sans", fontsize=19, margin="0.15,0.12"];
edge [fontname="DejaVu Sans", fontsize=16, arrowsize=0.75, penwidth=1.25, color="#276A96"];
"0" [label="0\nStudent Exchange",width=2.7,height=1.12];
"E1" [label="E1\nVisitor / student",width=2.7,height=1.12];
"E2" [label="E2\nAdministrator",width=2.7,height=1.12];
"E3" [label="E3\nDirect listing API\nclient",width=2.7,height=1.12];
{rank=same; "E1";"E2";"E3";}
{rank=same; "0";}
"E1" -> "E2" [style=invis,weight=30];
"E2" -> "E3" [style=invis,weight=30];
"E1" -> "0" [style=invis,weight=100];
"E1" -> "0" [label="Marketplace + account\nrequests",constraint=false,id="edge0"];
"0" -> "E1" [label="Marketplace + account\nresults",constraint=false,id="edge1"];
"E2" -> "0" [label="Administration requests",constraint=false,id="edge2"];
"0" -> "E2" [label="Administration results",constraint=false,id="edge3"];
"E3" -> "0" [label="Direct listing requests",constraint=false,id="edge4"];
"0" -> "E3" [label="Direct listing results",constraint=false,id="edge5"];
}