digraph DFD {
graph [rankdir=LR, bgcolor="transparent", splines=polyline, nodesep=0.42, ranksep=1.4, pad=0.12, outputorder=edgesfirst];
node [shape=box, fontname="DejaVu Sans", fontsize=19, margin="0.15,0.12"];
edge [fontname="DejaVu Sans", fontsize=16, arrowsize=0.75, penwidth=1.25, color="#276A96"];
"2.1" [label="2.1\nRegister account",width=2.7,height=1.12];
