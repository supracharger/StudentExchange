digraph DFD {
graph [rankdir=LR, bgcolor="transparent", splines=polyline, nodesep=0.2, ranksep=1.4, pad=0.12, outputorder=edgesfirst];
node [shape=box, fontname="DejaVu Sans", fontsize=19, margin="0.15,0.12"];
edge [fontname="DejaVu Sans", fontsize=16, arrowsize=0.75, penwidth=1.25, color="#276A96"];
"3.1" [label="3.1\nAssess caller\npermissions",width=2.7,height=1.12];
"3.2" [label="3.2\nManage target user\nrecords",width=2.7,height=1.12];
"D3" [label="D3\nSchool directory",width=3.0,height=0.84];
"D4" [label="D4\nUser accounts",width=3.0,height=0.84];
"D5" [label="D5\nAdmin memberships",width=3.0,height=0.84];
"E2" [label="E2\nAdministrator",width=2.7,height=1.12];
{rank=same; "3.1";"E2";}
{rank=same; "3.2";}
{rank=same; "D3";"D4";"D5";}
"3.1" -> "E2" [style=invis,weight=30];
"D3" -> "D4" [style=invis,weight=30];
"D4" -> "D5" [style=invis,weight=30];
"3.1" -> "3.2" [style=invis,weight=100];
"3.2" -> "D3" [style=invis,weight=100];
"3.2" -> "E2" [label="User management result",constraint=false,id="edge0"];
"D4" -> "3.2" [label="Account reference data",constraint=false,id="edge1"];
"D3" -> "3.2" [label="School reference data",constraint=false,id="edge2"];
"3.2" -> "D4" [label="Managed record changes",constraint=false,id="edge3"];
"D5" -> "3.2" [label="Admin membership data",constraint=false,id="edge4"];
"3.1" -> "3.2" [label="Scoped user request",constraint=false,id="edge5"];
}