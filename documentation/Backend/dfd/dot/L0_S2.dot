"G5" [label="G5\nRuntime service\nrecords",width=3.0,height=0.84];
{rank=same; "2.0";"E2";}
{rank=same; "3.0";"4.0";}
{rank=same; "G2";"G3";"G5";}
"2.0" -> "E2" [style=invis,weight=30];
"3.0" -> "4.0" [style=invis,weight=30];
"G2" -> "G3" [style=invis,weight=30];
