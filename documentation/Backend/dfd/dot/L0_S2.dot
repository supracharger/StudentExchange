"G2" -> "3.0" [label="User / school references",constraint=false,id="edge6"];
"3.0" -> "G2" [label="Managed record changes",constraint=false,id="edge7"];
"G3" -> "3.0" [label="Admin / attempt\nreferences",constraint=false,id="edge8"];
"3.0" -> "G3" [label="Security record changes",constraint=false,id="edge9"];
