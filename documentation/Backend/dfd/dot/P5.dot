digraph DFD {
graph [rankdir=LR, bgcolor="transparent", splines=polyline, nodesep=0.42, ranksep=1.4, pad=0.12, outputorder=edgesfirst];
node [shape=box, fontname="DejaVu Sans", fontsize=19, margin="0.15,0.12"];
edge [fontname="DejaVu Sans", fontsize=16, arrowsize=0.75, penwidth=1.25, color="#276A96"];
"5.1" [label="5.1\nSelect expired token\nrecords",width=2.7,height=1.12];
"5.2" [label="5.2\nSelect expired user\nattempts",width=2.7,height=1.12];
"5.3" [label="5.3\nSelect expired IP\nattempts",width=2.7,height=1.12];
"5.4" [label="5.4\nSelect stale lock\nmetadata",width=2.7,height=1.12];
"D10" [label="D10\nIP attempt records",width=3.0,height=0.84];
"D15" [label="D15\nLock metadata",width=3.0,height=0.84];
"D6" [label="D6\nAccess tokens",width=3.0,height=0.84];
"D7" [label="D7\nUser attempt records",width=3.0,height=0.84];
{rank=same; "5.1";"5.2";"5.3";"5.4";}
{rank=same; "D10";"D15";"D6";"D7";}
"5.1" -> "5.2" [style=invis,weight=30];
"5.2" -> "5.3" [style=invis,weight=30];
"5.3" -> "5.4" [style=invis,weight=30];
"D10" -> "D15" [style=invis,weight=30];
"D15" -> "D6" [style=invis,weight=30];
"D6" -> "D7" [style=invis,weight=30];
"5.1" -> "D10" [style=invis,weight=100];
"D6" -> "5.1" [label="Token expiry records",constraint=false,id="edge0"];
"D7" -> "5.2" [label="User attempt expiry\nrecords",constraint=false,id="edge1"];
"D10" -> "5.3" [label="IP attempt expiry\nrecords",constraint=false,id="edge2"];
"5.1" -> "D6" [label="Expired token removal\ndata",constraint=false,id="edge3"];
"5.2" -> "D7" [label="Expired user-attempt\nremoval data",constraint=false,id="edge4"];
"5.3" -> "D10" [label="Expired IP-attempt\nremoval data",constraint=false,id="edge5"];
"D15" -> "5.4" [label="Lock metadata records",constraint=false,id="edge6"];
"5.4" -> "D15" [label="Stale lock removal data",constraint=false,id="edge7"];
}