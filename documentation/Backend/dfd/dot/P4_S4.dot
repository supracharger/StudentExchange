digraph DFD {
graph [rankdir=LR, bgcolor="transparent", splines=polyline, nodesep=0.2, ranksep=1.4, pad=0.12, outputorder=edgesfirst];
node [shape=box, fontname="DejaVu Sans", fontsize=19, margin="0.15,0.12"];
edge [fontname="DejaVu Sans", fontsize=16, arrowsize=0.75, penwidth=1.25, color="#276A96"];
"2.0" [label="2.0\nManage accounts and\nsessions",width=2.7,height=1.12];
"3.0" [label="3.0\nManage administration",width=2.7,height=1.12];
"4.3" [label="4.3\nAssess application and\nIP data",width=2.7,height=1.12];
"4.4" [label="4.4\nAssess user and target\ndata",width=2.7,height=1.12];
"4.5" [label="4.5\nPublish access\nassessment",width=2.7,height=1.12];
{rank=same; "2.0";"3.0";"4.3";"4.4";}
{rank=same; "4.5";}
"2.0" -> "3.0" [style=invis,weight=30];
"3.0" -> "4.3" [style=invis,weight=30];
"4.3" -> "4.4" [style=invis,weight=30];
"2.0" -> "4.5" [style=invis,weight=100];
"4.5" -> "2.0" [label="Account access\nassessment",constraint=false,id="edge0"];
"4.5" -> "3.0" [label="Admin access assessment",constraint=false,id="edge1"];
"4.4" -> "4.5" [label="Resolved user context",constraint=false,id="edge2"];
"4.3" -> "4.5" [label="Application / IP\nrejection data",constraint=false,id="edge3"];
}