"D7" -> "D8" [style=invis,weight=30];
"D8" -> "D9" [style=invis,weight=30];
"3.1" -> "3.5" [style=invis,weight=100];
"3.5" -> "D10" [style=invis,weight=100];
"3.5" -> "E2" [label="Attempt management\nresult",constraint=false,id="edge0"];
"3.6" -> "E2" [label="Target sign-out\nconfirmation",constraint=false,id="edge1"];
"D4" -> "3.5" [label="Account reference data",constraint=false,id="edge2"];
