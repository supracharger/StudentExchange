"D8" [label="D8\nIP registry",width=3.0,height=0.84];
"D9" [label="D9\nUser / IP links",width=3.0,height=0.84];
"E2" [label="E2\nAdministrator",width=2.7,height=1.12];
{rank=same; "3.1";"E2";}
{rank=same; "3.5";"3.6";}
{rank=same; "D10";"D4";"D6";"D7";"D8";"D9";}
"3.1" -> "E2" [style=invis,weight=30];
"3.5" -> "3.6" [style=invis,weight=30];
"D10" -> "D4" [style=invis,weight=30];
