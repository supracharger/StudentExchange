digraph DFD {
graph [rankdir=LR, bgcolor="transparent", splines=polyline, nodesep=0.42, ranksep=1.4, pad=0.12, outputorder=edgesfirst];
node [shape=box, fontname="DejaVu Sans", fontsize=19, margin="0.15,0.12"];
edge [fontname="DejaVu Sans", fontsize=16, arrowsize=0.75, penwidth=1.25, color="#276A96"];
"3.1" [label="3.1\nAssess caller\npermissions",width=2.7,height=1.12];
"3.3" [label="3.3\nManage school records",width=2.7,height=1.12];
"3.4" [label="3.4\nManage admin\nassignments",width=2.7,height=1.12];
"D3" [label="D3\nSchool directory",width=3.0,height=0.84];
"D5" [label="D5\nAdmin memberships",width=3.0,height=0.84];
"E2" [label="E2\nAdministrator",width=2.7,height=1.12];
{rank=same; "3.1";"E2";}
{rank=same; "3.3";"3.4";}
{rank=same; "D3";"D5";}
"3.1" -> "E2" [style=invis,weight=30];
"3.3" -> "3.4" [style=invis,weight=30];
"D3" -> "D5" [style=invis,weight=30];
"3.1" -> "3.3" [style=invis,weight=100];
"3.3" -> "D3" [style=invis,weight=100];
"3.3" -> "E2" [label="School management result",constraint=false,id="edge0"];
"3.4" -> "E2" [label="Admin assignment result",constraint=false,id="edge1"];
"D3" -> "3.3" [label="School reference data",constraint=false,id="edge2"];
"3.3" -> "D3" [label="Managed record changes",constraint=false,id="edge3"];
"D5" -> "3.4" [label="Admin membership data",constraint=false,id="edge4"];
"3.4" -> "D5" [label="Admin membership changes",constraint=false,id="edge5"];
"3.1" -> "3.3" [label="Scoped school request",constraint=false,id="edge6"];
"3.1" -> "3.4" [label="Scoped assignment\nrequest",constraint=false,id="edge7"];
}