"1.1" -> "E1" [label="Listing selection view",constraint=false,id="edge4"];
"1.2" -> "E1" [label="Listing selection view",constraint=false,id="edge5"];
"1.3" -> "E1" [label="Message preview",constraint=false,id="edge6"];
"1.4" -> "E1" [label="Offer preview",constraint=false,id="edge7"];
"D1" -> "1.1" [label="Sample catalog data",constraint=false,id="edge8"];
"D1" -> "1.2" [label="Sample catalog data",constraint=false,id="edge9"];
"D2" -> "1.3" [label="Preview conversation\ndata",constraint=false,id="edge10"];
"D2" -> "1.4" [label="Preview conversation\ndata",constraint=false,id="edge11"];
"1.3" -> "D2" [label="Preview text updates",constraint=false,id="edge12"];
