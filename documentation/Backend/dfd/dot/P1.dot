"D2" [label="D2\nPreview conversation",width=3.0,height=0.84];
"E1" [label="E1\nVisitor / student",width=2.7,height=1.12];
{rank=same; "E1";}
{rank=same; "1.1";"1.2";"1.3";"1.4";}
{rank=same; "D1";"D2";}
"1.1" -> "1.2" [style=invis,weight=30];
"1.2" -> "1.3" [style=invis,weight=30];
"1.3" -> "1.4" [style=invis,weight=30];
"D1" -> "D2" [style=invis,weight=30];
"E1" -> "1.1" [style=invis,weight=100];
"1.1" -> "D1" [style=invis,weight=100];
"E1" -> "1.1" [label="Browse criteria",constraint=false,id="edge0"];
"E1" -> "1.2" [label="Browse criteria",constraint=false,id="edge1"];
"E1" -> "1.3" [label="Message draft",constraint=false,id="edge2"];
