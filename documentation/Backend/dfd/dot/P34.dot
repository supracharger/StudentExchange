digraph DFD {
graph [rankdir=LR, bgcolor="transparent", splines=polyline, nodesep=0.42, ranksep=1.4, pad=0.12, outputorder=edgesfirst];
node [shape=box, fontname="DejaVu Sans", fontsize=19, margin="0.15,0.12"];
edge [fontname="DejaVu Sans", fontsize=16, arrowsize=0.75, penwidth=1.25, color="#276A96"];
"3.1" [label="3.1\nAssess caller\npermissions",width=2.7,height=1.12];
"3.4.1" [label="3.4.1\nValidate assignment\nfields",width=2.7,height=1.12];
"3.4.2" [label="3.4.2\nAssess target\nmembership operation",width=2.7,height=1.12];
"3.4.3" [label="3.4.3\nPersist and project\nassignment",width=2.7,height=1.12];
"D5" [label="D5\nAdmin memberships",width=3.0,height=0.84];
"E2" [label="E2\nAdministrator",width=2.7,height=1.12];
{rank=same; "3.1";"E2";}
{rank=same; "3.4.1";"3.4.2";"3.4.3";}
{rank=same; "D5";}
"3.1" -> "E2" [style=invis,weight=30];
"3.4.1" -> "3.4.2" [style=invis,weight=30];
"3.4.2" -> "3.4.3" [style=invis,weight=30];
"3.1" -> "3.4.1" [style=invis,weight=100];
"3.4.1" -> "D5" [style=invis,weight=100];
"3.4.3" -> "E2" [label="Admin assignment result",constraint=false,id="edge0"];
"D5" -> "3.4.2" [label="Admin membership data",constraint=false,id="edge1"];
"3.4.3" -> "D5" [label="Admin membership changes",constraint=false,id="edge2"];
"3.1" -> "3.4.1" [label="Scoped assignment\nrequest",constraint=false,id="edge3"];
"3.4.1" -> "3.4.2" [label="Validated assignment\ndata",constraint=false,id="edge4"];
"3.4.2" -> "3.4.3" [label="Permitted membership\nchanges",constraint=false,id="edge5"];
}