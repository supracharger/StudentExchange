# Local
@StudentExchangeBck_HostAddress = http://localhost:5239
# Azure
#@StudentExchangeBck_HostAddress = https://studentexchangebck-fpdnfpcqe4bje2eh.westus-01.azurewebsites.net

# Log in
POST {{StudentExchangeBck_HostAddress}}/LogIn/
Accept: application/json
# Log out
DELETE {{StudentExchangeBck_HostAddress}}/LogIn/
Accept: application/json

# Register user
POST {{StudentExchangeBck_HostAddress}}/Register/
Accept: application/json
# Get user info
GET {{StudentExchangeBck_HostAddress}}/Register/
Accept: application/json
# Update user info
PATCH {{StudentExchangeBck_HostAddress}}/Register/
Accept: application/json
# Delete User
DELETE {{StudentExchangeBck_HostAddress}}/Register/
Accept: application/json

# Get all valid schools
GET {{StudentExchangeBck_HostAddress}}/Schools/
Accept: application/json
# Add School to DB
POST {{StudentExchangeBck_HostAddress}}/Schools/
Accept: application/json
# Delete School from DB
DELETE {{StudentExchangeBck_HostAddress}}/Schools/
Accept: application/json

# GET Users table from DB
GET {{StudentExchangeBck_HostAddress}}/Users/
Accept: application/json

# Get if Admin
GET {{StudentExchangeBck_HostAddress}}/Admin/
Accept: application/json

# Get Blocked IPs and Users
GET {{StudentExchangeBck_HostAddress}}/Blocked/
Accept: application/json
# Delete Blocked IPs or Users
DELETE {{StudentExchangeBck_HostAddress}}/Blocked/
Accept: application/json
