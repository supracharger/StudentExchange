Accept: application/json
# Get user info
GET {{StudentExchangeBck_HostAddress}}/Register/
Accept: application/json
# Update user info
PATCH {{StudentExchangeBck_HostAddress}}/Register/
Accept: application/json
# Delete User
DELETE {{StudentExchangeBck_HostAddress}}/Register/
Accept: application/json

# Get all valid schools
